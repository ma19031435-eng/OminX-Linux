[kdeglobals][KDE]
widgetStyle=Breeze
LookAndFeelPackage=com.ominx.harbor

[kdeglobals][General]
ColorScheme=OminXHarbor
Name=OminX Harbor
font=Noto Sans,10,-1,5,50,0,0,0,0,0

[kdeglobals][Icons]
Theme=breeze-dark

[plasmarc][Theme]
name=breeze-dark

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=M
ButtonsOnRight=IAX
TitleAlignment=1
BorderSize=2

[kwinrc][Desktops]
Number=2
Rows=1

[kwinrc][Windows]
FocusPolicy=ClickToFocus
Placement=Maximizing

[kwinrc][Plugins]
blurEnabled=false
contrastEnabled=false

[ksmserverrc][General]
confirmLogout=true

[Wallpaper]
Image=file:///usr/share/plasma/look-and-feel/com.ominx.harbor/contents/images/harbor-wallpaper.svg
