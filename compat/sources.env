MINGW_TAG=v12.0.0
MINGW_COMMIT=819a6ec2ea87c19814b287e21d65e0dc7f05abba
# zlib for the Wine runtime is pinned as a git tag. zlib.net answered an HTML
# page to the CI builder, so the graphics track (sources.json) is unchanged.
ZLIB_REPO=https://github.com/madler/zlib.git
ZLIB_TAG=v1.3.2
ZLIB_COMMIT=da607da739fa6047df13e66a2af6b8bec7c2a498
