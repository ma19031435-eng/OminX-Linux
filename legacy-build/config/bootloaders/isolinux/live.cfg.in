menu hshift 0
menu width 82
menu title OminX Aurora - Boot and install
menu background splash.png
include stdmenu.cfg

label live-@FLAVOUR@
    menu label ^Try OminX Aurora
    menu default
    linux @LINUX@
    initrd @INITRD@
    append @APPEND_LIVE@

label installgui
    menu label ^Install OminX (graphical)
    linux /install/gtk/vmlinuz
    initrd /install/gtk/initrd.gz
    append video=vesa:ywrap,mtrr vga=788 @APPEND_INSTALL@ --- quiet

menu begin advanced
    menu title Advanced options
    include stdmenu.cfg

    label live-@FLAVOUR@-failsafe
        menu label ^OminX Aurora (safe graphics)
        linux @LINUX@
        initrd @INITRD@
        append @APPEND_LIVE_FAILSAFE@

    label install
        menu label ^Install OminX (text mode)
        linux /install/vmlinuz
        initrd /install/initrd.gz
        append vga=788 @APPEND_INSTALL@ --- quiet

    label mainmenu
        menu label ^Back to OminX menu
        menu exit
menu end
