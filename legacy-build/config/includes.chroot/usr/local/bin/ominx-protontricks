#!/bin/sh
# Optional helper: fetch Protontricks from PyPI into the current user's pipx env.
set -eu

if ! command -v pipx >/dev/null 2>&1; then
    echo "pipx is not installed. Install it with: sudo apt install pipx" >&2
    exit 1
fi

APP="$HOME/.local/bin/protontricks"
if [ ! -x "$APP" ]; then
    pipx install protontricks
fi

exec "$APP" --gui "$@"
