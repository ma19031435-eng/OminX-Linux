#!/bin/sh
# Add the 32-bit userspace and compatibility stack after the base desktop has
# been installed. Keeping this after the normal package selection ensures the
# i386 architecture is enabled before Steam and Wine are resolved.
set -eu

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a

dpkg --add-architecture i386
apt-get update
apt-get install --yes --no-install-recommends \
    steam-installer \
    steam-devices \
    wine \
    wine64 \
    wine32:i386 \
    wine-binfmt \
    winetricks \
    lutris \
    libgl1-mesa-dri:i386 \
    libvulkan1:i386 \
    mesa-vulkan-drivers:i386 \
    libpulse0:i386 \
    libasound2-plugins:i386

# Register OminX's Windows-app handler for double-click and Open With actions.
desktop-file-validate /usr/share/applications/ominx-windows-app.desktop
update-desktop-database --quiet /usr/share/applications

# Validate Cinnamon applet defaults against the version actually installed in
# this image so a package update cannot silently discard the OminX taskbar.
python3 - <<'PY'
import json
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio

# Fail the image build rather than shipping defaults that a package update
# silently drops. Inspecting schemas needs no running desktop session.
required_schema_keys = {
    "org.nemo.preferences": {
        "always-use-browser",
        "click-policy",
        "default-folder-viewer",
        "default-sort-order",
        "sort-directories-first",
        "show-location-entry",
        "show-directory-item-counts",
        "show-image-thumbnails",
        "show-home-icon-toolbar",
        "show-computer-icon-toolbar",
        "show-new-folder-icon-toolbar",
    },
    "org.nemo.window-state": {
        "sidebar-width",
        "start-with-toolbar",
        "start-with-location-bar",
        "start-with-status-bar",
        "start-with-sidebar",
        "start-with-menu-bar",
        "side-pane-view",
        "my-computer-expanded",
        "bookmarks-expanded",
        "devices-expanded",
        "network-expanded",
    },
    "org.nemo.desktop": {"use-desktop-grid"},
    "org.cinnamon.desktop.keybindings": {"custom-list"},
    "org.cinnamon.desktop.keybindings.custom-keybinding": {
        "name",
        "command",
        "binding",
    },
    "org.cinnamon.desktop.keybindings.wm": {
        "panel-run-dialog",
        "show-desktop",
        "switch-to-workspace-down",
        "switch-to-workspace-up",
        "maximize",
        "unmaximize",
        "push-tile-left",
        "push-tile-right",
    },
    "org.cinnamon.desktop.keybindings.media-keys": {
        "screensaver",
        "area-screenshot",
    },
    "org.cinnamon.muffin": {"edge-tiling", "tile-maximize"},
}
schema_source = Gio.SettingsSchemaSource.get_default()
for schema_id, expected_keys in required_schema_keys.items():
    schema = schema_source.lookup(schema_id, True)
    if schema is None:
        raise SystemExit(f"Missing GSettings schema {schema_id}")
    missing = sorted(expected_keys - set(schema.list_keys()))
    if missing:
        raise SystemExit(f"Missing keys in GSettings schema {schema_id}: {', '.join(missing)}")

applets = Path("/usr/share/cinnamon/applets")
for uuid in ("menu@cinnamon.org", "grouped-window-list@cinnamon.org"):
    applet_dir = applets / uuid
    schema = json.loads((applet_dir / "settings-schema.json").read_text(encoding="utf-8"))
    override = json.loads((applet_dir / "settings-override.json").read_text(encoding="utf-8"))
    unknown = sorted(set(override) - set(schema))
    if unknown:
        raise SystemExit(f"Unknown settings for {uuid}: {', '.join(unknown)}")
    for key, values in override.items():
        if "default" not in schema[key] or "default" not in values:
            raise SystemExit(f"Invalid default override for {uuid}:{key}")
        if "default" not in values.get("override-props", []):
            raise SystemExit(f"Missing default override flag for {uuid}:{key}")
PY

for desktop_id in nemo.desktop firefox-esr.desktop org.gnome.Software.desktop libreoffice-writer.desktop; do
    test -r "/usr/share/applications/$desktop_id"
done

# Make the official Flathub catalog available in the desktop software center.
# Apps are not preinstalled from this third-party remote.
flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo

# Compile the system-wide Cinnamon wallpaper and panel defaults shipped in the
# chroot overlay.
dconf update

apt-get clean
rm -rf /var/lib/apt/lists/*
