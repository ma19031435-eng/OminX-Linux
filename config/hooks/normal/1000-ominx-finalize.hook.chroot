#!/bin/sh
# Add the 32-bit userspace and compatibility stack after the base desktop has
# been installed. Keeping this after normal package selection ensures the
# i386 architecture is enabled before Steam and Wine are resolved.
set -eu

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a

dpkg --add-architecture i386
apt-get update
apt-get install --yes --no-install-recommends \
    steam-installer \
    steam-devices \
    wine \
    wine64 \
    wine32:i386 \
    wine-binfmt \
    winetricks \
    lutris \
    libgl1-mesa-dri:i386 \
    libvulkan1:i386 \
    mesa-vulkan-drivers:i386 \
    libpulse0:i386 \
    libasound2-plugins:i386

# Discover is the real Debian/Flatpak package manager behind the OminX Store.
# Keep its native launcher available to OminX Store, but avoid a second Store
# icon in the Plasma application launcher.
mkdir -p /usr/local/share/applications
cp /usr/share/applications/org.kde.discover.desktop \
    /usr/local/share/applications/org.kde.discover.desktop
desktop-file-edit --set-key=NoDisplay --set-value=true \
    /usr/local/share/applications/org.kde.discover.desktop

for executable in \
    /usr/local/bin/ominx-store \
    /usr/local/bin/ominx-settings \
    /usr/local/bin/ominx-setup \
    /usr/bin/plasma-discover \
    /usr/bin/plasmashell \
    /usr/bin/systemsettings; do
    test -x "$executable"
done

test -r /usr/share/xsessions/plasmax11.desktop
test -r /usr/share/applications/org.kde.dolphin.desktop
for file in \
    /usr/share/applications/ominx-store.desktop \
    /usr/share/applications/ominx-settings.desktop \
    /usr/share/applications/ominx-setup.desktop \
    /usr/share/applications/ominx-windows-app.desktop \
    /usr/local/share/applications/org.kde.discover.desktop; do
    test -r "$file"
done
desktop-file-validate \
    /usr/share/applications/ominx-store.desktop \
    /usr/share/applications/ominx-settings.desktop \
    /usr/share/applications/ominx-setup.desktop \
    /usr/share/applications/ominx-windows-app.desktop \
    /usr/local/share/applications/org.kde.discover.desktop
update-desktop-database --quiet /usr/share/applications
update-desktop-database --quiet /usr/local/share/applications

grep -q '^NoDisplay=true$' /usr/local/share/applications/org.kde.discover.desktop

# Validate the OminX Plasma Look-and-Feel package and native desktop defaults
# before the image is finalized, so an incomplete theme cannot ship silently.
python3 - <<'PY'
import configparser
import json
from pathlib import Path

look_and_feel = Path("/usr/share/plasma/look-and-feel/com.ominx.aurora")
metadata = json.loads((look_and_feel / "metadata.json").read_text(encoding="utf-8"))
if metadata.get("KPackageStructure") != "Plasma/LookAndFeel":
    raise SystemExit("OminX Aurora is not a Plasma Look-and-Feel package")
if metadata.get("KPlugin", {}).get("Id") != "com.ominx.aurora":
    raise SystemExit("OminX Aurora has the wrong Plasma theme ID")
layout = look_and_feel / "contents/layouts/org.kde.plasma.desktop-layout.js"
layout_text = layout.read_text(encoding="utf-8")
for widget in (
    "org.kde.plasma.kickoff",
    "org.kde.plasma.icontasks",
    "org.kde.plasma.systemtray",
    "org.kde.plasma.digitalclock",
    "org.kde.plasma.showdesktop",
):
    if widget not in layout_text:
        raise SystemExit(f"OminX Plasma layout is missing {widget}")
if "ominx-wallpaper.svg" not in layout_text:
    raise SystemExit("OminX Plasma layout is missing the Aurora wallpaper")

colors = configparser.ConfigParser(interpolation=None, strict=True)
colors.read("/usr/share/color-schemes/OminX-Aurora.colors", encoding="utf-8")
for section in ("General", "Colors:Window", "Colors:View", "Colors:Button", "Colors:Selection", "WM"):
    if not colors.has_section(section):
        raise SystemExit(f"OminX Aurora color scheme is missing [{section}]")

plasma_defaults = Path("/etc/xdg/kdeglobals").read_text(encoding="utf-8")
if "LookAndFeelPackage=com.ominx.aurora" not in plasma_defaults:
    raise SystemExit("New Plasma sessions must load the OminX Aurora Look-and-Feel package")
if "ColorScheme=OminX-Aurora" not in plasma_defaults:
    raise SystemExit("The OminX Plasma color scheme is not selected by default")
PY

grep -q '^user-session=plasmax11$' /etc/lightdm/lightdm.conf.d/50-ominx.conf
grep -q '^name=ominx-aurora$' /etc/xdg/plasmarc

grep -q '^GtkTheme=OminX$' /usr/share/themes/OminX/index.theme

for desktop_id in org.kde.dolphin.desktop firefox-esr.desktop ominx-store.desktop libreoffice-writer.desktop; do
    test -r "/usr/share/applications/$desktop_id"
done
test -r /usr/share/applications/ominx-settings.desktop
test -r /usr/share/applications/ominx-setup.desktop
test -x /usr/bin/steam
test -x /usr/bin/plasma-discover

# Make the official Flathub catalog available in Discover. Apps are not
# preinstalled from this third-party remote.
flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo

apt-get clean
rm -rf /var/lib/apt/lists/*
