#!/bin/sh
# Open one Windows application or installer safely through Wine.
set -eu

APP_TITLE='OminX Windows App Support'

show_error() {
    message=$1
    if command -v zenity >/dev/null 2>&1; then
        if zenity --error --title="$APP_TITLE" --text="$message" >/dev/null 2>&1; then
            return 0
        fi
    fi
    printf '%s\n' "$message" >&2
}

if [ "$#" -eq 0 ]; then
    if ! command -v zenity >/dev/null 2>&1; then
        show_error 'Choose a Windows .exe or .msi file from the file manager.'
        exit 2
    fi
    target=$(zenity --file-selection \
        --title='Choose a Windows application or installer' \
        --file-filter='Windows programs (*.exe, *.msi) | *.exe *.EXE *.msi *.MSI' \
        --file-filter='All files | *' 2>/dev/null) || exit 0
    [ -n "$target" ] || exit 0
elif [ "$#" -eq 1 ]; then
    target=$1
else
    show_error 'Open one Windows application or installer at a time.'
    exit 2
fi

if [ ! -f "$target" ] || [ ! -r "$target" ]; then
    show_error 'The selected file cannot be read. Check that it still exists and that you have permission to open it.'
    exit 2
fi

case "$target" in
    *.[Ee][Xx][Ee]) file_type=exe ;;
    *.[Mm][Ss][Ii]) file_type=msi ;;
    *)
        show_error 'OminX Windows App Support opens .exe and .msi files only.'
        exit 2
        ;;
esac

if ! command -v wine >/dev/null 2>&1; then
    show_error 'Wine is not available. Install or repair the Wine packages, then try again.'
    exit 127
fi

# The prefix is prepared in the background at first sign-in. If a user
# manages to open a program before that finishes (or the service never
# ran), wait for the same one-time setup instead of racing wineboot.
if command -v ominx-wine-firstboot >/dev/null 2>&1; then
    ominx-wine-firstboot --wait 2>/dev/null || true
fi

# Start in the selected file's directory. Some Windows installers expect their
# companion files to be found relative to the installer rather than the user's
# home directory or the file manager's working directory.
target_dir=$(dirname -- "$target")
target_name=$(basename -- "$target")
if ! cd -- "$target_dir"; then
    show_error 'Could not open the folder containing the selected file.'
    exit 2
fi
target_path=$(pwd -P)/$target_name

case "$file_type" in
    exe) exec wine "$target_path" ;;
    msi) exec wine msiexec /i "$target_path" ;;
esac
