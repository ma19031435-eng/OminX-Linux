[org/cinnamon]
panels-enabled=['1:0:bottom']
panels-height=['1:48']
panels-resizable=['1:true']
enabled-applets=['panel1:center:0:menu@cinnamon.org:0', 'panel1:center:1:grouped-window-list@cinnamon.org:1', 'panel1:right:0:systray@cinnamon.org:3', 'panel1:right:1:xapp-status@cinnamon.org:4', 'panel1:right:2:notifications@cinnamon.org:5', 'panel1:right:3:printers@cinnamon.org:6', 'panel1:right:4:removable-drives@cinnamon.org:7', 'panel1:right:5:keyboard@cinnamon.org:8', 'panel1:right:6:network@cinnamon.org:9', 'panel1:right:7:sound@cinnamon.org:10', 'panel1:right:8:power@cinnamon.org:11', 'panel1:right:9:calendar@cinnamon.org:12', 'panel1:right:10:cornerbar@cinnamon.org:13']
favorite-apps=['nemo.desktop', 'firefox-esr.desktop', 'org.gnome.Software.desktop', 'libreoffice-writer.desktop']

[org/cinnamon/theme]
name='OminX'

[org/cinnamon/desktop/background]
picture-uri='file:///usr/share/backgrounds/ominx/ominx-wallpaper.svg'
picture-options='zoom'
color-shading-type='solid'
primary-color='#07111f'
secondary-color='#142544'

[org/cinnamon/desktop/interface]
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'
font-name='Noto Sans 10'

[org/gnome/desktop/interface]
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'
font-name='Noto Sans 10'

[org/gnome/desktop/wm/preferences]
button-layout=':minimize,maximize,close'
action-double-click-titlebar='toggle-maximize'
titlebar-font='Noto Sans Bold 10'

[org/nemo/desktop]
show-desktop-icons=true
use-desktop-grid=true
home-icon-visible=true
computer-icon-visible=true
trash-icon-visible=true
volumes-visible=true
network-icon-visible=true

# Nemo is arranged like a modern Explorer-style file browser: places and
# devices at the left, breadcrumb navigation above a details list, and a
# status bar below. All behavior and artwork remain native Linux components.
[org/nemo/preferences]
always-use-browser=true
click-policy='double'
default-folder-viewer='list-view'
default-sort-order='name'
default-sort-in-reverse-order=false
sort-directories-first=true
sort-favorites-first=true
show-hidden-files=false
show-location-entry=false
show-directory-item-counts='local-only'
show-image-thumbnails='local-only'
show-full-path-titles=false
show-bookmarks-in-to-menus=true
show-advanced-permissions=false
start-with-dual-pane=false
executable-text-activation='ask'
enable-delete=true
confirm-move-to-trash=false
confirm-trash=true
date-format='locale'
tabs-open-position='after-current-tab'
show-previous-icon-toolbar=true
show-next-icon-toolbar=true
show-up-icon-toolbar=true
show-reload-icon-toolbar=true
show-edit-icon-toolbar=true
show-home-icon-toolbar=true
show-computer-icon-toolbar=true
show-search-icon-toolbar=true
show-new-folder-icon-toolbar=true
show-icon-view-icon-toolbar=true
show-list-view-icon-toolbar=true
show-compact-view-icon-toolbar=true

[org/nemo/window-state]
sidebar-width=200
start-with-toolbar=true
start-with-location-bar=true
start-with-status-bar=true
start-with-sidebar=true
start-with-menu-bar=false
side-pane-view='places'
my-computer-expanded=true
bookmarks-expanded=true
devices-expanded=true
network-expanded=true

# Familiar keyboard workflows, implemented with Cinnamon and Linux apps.
[org/cinnamon/desktop/keybindings]
custom-list=['custom0', 'custom1', 'custom2']

[org/cinnamon/desktop/keybindings/custom-keybindings/custom0]
name='Open Files'
command='nemo'
binding=['<Super>e']

[org/cinnamon/desktop/keybindings/custom-keybindings/custom1]
name='Open System Settings'
command='cinnamon-settings'
binding=['<Super>i']

[org/cinnamon/desktop/keybindings/custom-keybindings/custom2]
name='Open System Monitor'
command='gnome-system-monitor'
binding=['<Control><Shift>Escape']

[org/cinnamon/desktop/keybindings/wm]
panel-run-dialog=['<Alt>F2', '<Super>r']
show-desktop=['<Super>d']
switch-to-workspace-down=['<Super>Tab']
switch-to-workspace-up=['<Super><Control>Up']
maximize=['<Super>Up']
unmaximize=['<Super>Down']
push-tile-left=['<Super>Left']
push-tile-right=['<Super>Right']

[org/cinnamon/desktop/keybindings/media-keys]
screensaver=['<Super>l']
area-screenshot=['<Shift>Print', '<Super><Shift>s']

[org/cinnamon/muffin]
edge-tiling=true
tile-maximize=true
